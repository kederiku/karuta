# Général
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me

# Base de données
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=karuta
POSTGRES_USER=karuta
POSTGRES_PASSWORD=change-me
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
TASKIQ_BROKER_URL=redis://localhost:6379/1

# Stockage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=karuta-media
S3_PUBLIC_URL=http://localhost:9000/karuta-media

# Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion
INGEST_HMAC_SECRET=change-me
INGEST_MAX_BATCH_SIZE=500

# Matching
MATCH_AUTO_THRESHOLD=95
MATCH_REVIEW_THRESHOLD=70

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ROOT_DOMAIN=karuta.local
