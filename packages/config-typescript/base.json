{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,

    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "skipLibCheck": true,

    // Sans cette option, `tsc -p` écrit des .js à côté des sources ; le .gitignore
    // ne les filtre pas et ils finiraient commités. Le bundler de chaque app émet.
    "noEmit": true
  }
}
